{
  "name": "wedageco-desktop",
  "productName": "Wedage & Co. Desktop",
  "version": "1.0.0",
  "description": "Electron desktop wrapper around the existing Wedage & Co. web application. Reuses the web build unchanged and shares the same Firebase backend.",
  "private": true,
  "author": "Wedage & Co.",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "build:web": "npm --prefix .. run build",
    "start": "electron .",
    "dev": "cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "predist": "npm run build:web",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "lk.smartlabs.wedageco.desktop",
    "productName": "Wedage & Co. Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "splash.html",
      "splash-preload.cjs",
      "assets/**/*",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://YOUR_UPDATE_SERVER_URL/wedageco-desktop/"
      }
    ]
  }
}

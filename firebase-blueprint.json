{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with role-based access",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["developer", "superAdmin", "admin", "operations", "accounts", "driver"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client company details and agreements",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "brNo": { "type": "string" },
        "brImage": { "type": "string" },
        "officialContact": { "type": "string" },
        "vatNo": { "type": "string" },
        "opsContactName": { "type": "string" },
        "opsContactNumber": { "type": "string" },
        "billingContactName": { "type": "string" },
        "billingContactNumber": { "type": "string" },
        "agreementUrl": { "type": "string" },
        "agreementStart": { "type": "string", "format": "date" },
        "agreementEnd": { "type": "string", "format": "date" }
      },
      "required": ["name", "brNo", "officialContact", "agreementStart", "agreementEnd"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Vendor and supplier contact data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "brNo": { "type": "string" },
        "vatNo": { "type": "string" }
      },
      "required": ["name", "email", "phone"]
    },
    "Staff": {
      "title": "Staff",
      "description": "HR records for employees",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["driver", "helper", "cleaning", "office"] },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "licenseNo": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "type", "active"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Fleet vehicle specifications and status",
      "type": "object",
      "properties": {
        "plateNo": { "type": "string" },
        "type": { "type": "string", "enum": ["prime-mover", "lorry", "container", "other"] },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "chassisNo": { "type": "string" },
        "engineNo": { "type": "string" },
        "fuelType": { "type": "string", "enum": ["diesel", "petrol"] },
        "status": { "type": "string", "enum": ["active", "maintenance", "unavailable"] },
        "ownership": { "type": "string", "enum": ["owned", "rented"] },
        "length": { "type": "number", "description": "Length in feet" },
        "width": { "type": "number", "description": "Width in feet" },
        "height": { "type": "number", "description": "Height in feet" },
        "weightCapacity": { "type": "number", "description": "Weight capacity in tons" }
      },
      "required": ["plateNo", "type", "status", "ownership"]
    },
    "LogSheet": {
      "title": "LogSheet",
      "description": "Daily operational trip details with meter and freezer tracking",
      "type": "object",
      "properties": {
        "logSheetCode": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "customerId": { "type": "string" },
        "representative": { "type": "string" },
        "vehicleId": { "type": "string" },
        "driverId": { "type": "string" },
        "helperId": { "type": "string" },
        "meterStatus": { "type": "string", "enum": ["Working", "Not Working"] },
        "startMileage": { "type": "number" },
        "endMileage": { "type": "number" },
        "totalKm": { "type": "number" },
        "outTime": { "type": "string" },
        "inTime": { "type": "string" },
        "meterNonWorkingReason": { "type": "string" },
        "vehicleHasFreezer": { "type": "boolean" },
        "freezerOnTime": { "type": "string" },
        "freezerOffTime": { "type": "string" },
        "freezerTotalHours": { "type": "number" },
        "freezerTemp": { "type": "number" },
        "freezerRemarks": { "type": "string" },
        "freezerStatus": { "type": "string", "enum": ["ON", "OFF"] },
        "status": { "type": "string", "enum": ["On Trip", "Completed", "Breakdown", "Cancelled"] },
        "breakdownReason": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "approvedBy": { "type": "string" },
        "enteredBy": { "type": "string" }
      },
      "required": ["logSheetCode", "date", "vehicleId", "driverId", "customerId", "status"]
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "description": "Inventory or service procurement records",
      "type": "object",
      "properties": {
        "poNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "items": { "type": "array" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Sent", "Partially Received", "Fully Received", "Cancelled"] }
      },
      "required": ["poNumber", "date", "supplierId", "grandTotal", "status"]
    },
    "GRN": {
      "title": "Goods Received Note",
      "description": "Verified physical delivery records",
      "type": "object",
      "properties": {
        "grnNo": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "purchaseOrderRef": { "type": "string" },
        "conditionOfGoods": { "type": "string", "enum": ["Good", "Damaged", "Partial", "Rejected"] },
        "items": { "type": "array" }
      },
      "required": ["grnNo", "date", "supplierId", "conditionOfGoods"]
    },
    "DailyVehicleUpdate": {
      "title": "Daily Vehicle Update",
      "description": "Daily operational snapshot of an asset",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "dayOfWeek": { "type": "string" },
        "vehicleId": { "type": "string" },
        "vehicleNo": { "type": "string" },
        "actualDriverId": { "type": "string" },
        "actualDriverName": { "type": "string" },
        "status": { "type": "string", "enum": ["On Trip", "Breakdown", "Yard Parking", "Under Repair", "Personal Use", "Other"] }
      },
      "required": ["date", "vehicleId", "actualDriverId", "status"]
    },
    "Maintenance": {
      "title": "Maintenance",
      "description": "Garage and repair records",
      "type": "object",
      "properties": {
        "vehicleId": { "type": "string" },
        "supplierId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "cost": { "type": "number" },
        "partsReplaced": { "type": "string" },
        "billUrl": { "type": "string" }
      },
      "required": ["vehicleId", "date", "description", "cost"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Financial billing to customers",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "sent", "paid", "overdue"] }
      },
      "required": ["customerId", "invoiceNo", "date", "totalAmount", "status"]
    },
    "GatePass": {
      "title": "GatePass",
      "description": "Vehicle entry/exit security records",
      "type": "object",
      "properties": {
        "gatePassNo": { "type": "string" },
        "linkedLogSheetNo": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "vehicleNo": { "type": "string" },
        "driverName": { "type": "string" },
        "timeOut": { "type": "string" },
        "timeIn": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "Returned", "Cancelled"] }
      },
      "required": ["gatePassNo", "date", "vehicleNo", "driverName", "timeOut", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profiles"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Supplier profiles"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Staff records"
    },
    "/fleet/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Vehicle records"
    },
    "/logs/{logId}": {
      "schema": "LogSheet",
      "description": "Operational logs"
    },
    "/maintenance/{maintenanceId}": {
      "schema": "Maintenance",
      "description": "Vehicle maintenance records"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Billing records"
    },
    "/purchase_orders/{poId}": {
      "schema": "PurchaseOrder",
      "description": "Purchase order records"
    },
    "/grns/{grnId}": {
      "schema": "GRN",
      "description": "Goods received notes"
    },
    "/daily_updates/{updateId}": {
      "schema": "DailyVehicleUpdate",
      "description": "Daily fleet status updates"
    },
    "/gate_passes/{passId}": {
      "schema": "GatePass",
      "description": "Security gate pass records"
    }
  }
}
